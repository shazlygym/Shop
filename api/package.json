{
  "name": "@swc/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node -e \"const fs=require('fs');if(!fs.existsSync('../../dashboard/dist'))console.warn('[api] dashboard/dist missing - run npm run build -w dashboard')\" && node dist/index.js",
    "pretest": "DATABASE_URL=file:./test.db prisma db push --skip-generate",
    "test": "vitest run",
    "db:push": "DATABASE_URL=file:./dev.db prisma db push",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@swc/shared": "*",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/supertest": "^7.2.1",
    "prisma": "^5.14.0",
    "supertest": "^7.2.2",
    "tsx": "^4.10.5",
    "vitest": "^1.6.0"
  }
}
